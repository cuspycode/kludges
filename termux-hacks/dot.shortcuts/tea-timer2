#!/data/data/com.termux/files/usr/bin/bash

STATUS="$HOME/.tea-timer-status.txt"

PHRASE[0]="Your tea is ready."
PHRASE[1]="You can remove the tea bag now."
PHRASE[2]="I think the tea is done."
PHRASE[3]="Yet another cup of tea."
# Fyodor Dostoyevsky
PHRASE[4]="I say let the world go to hell, but I should always have my tea."
# Douglas Adams
PHRASE[5]="You now have something quite but not entirely unlike tea"
# Leo Tolstoy
PHRASE[6]="I must drink my tea; it is my oil, without which my engine won't go."
# Arthur Schopenauer
PHRASE[7]="Tea is the only good thing that came out of the British Empire."
# Abraham Lincoln
PHRASE[8]="If this is coffee, please bring me some tea; but if this is tea, please bring me some coffee."
N=9

ZACC=$(termux-sensor -d 50 -n 1 -s Accelerometer |\
    jq -r 'to_entries[0].value.values[1]|floor')

if [ "$ZACC" -lt -7 ]; then
    echo $ZACC Upside down.
    IFS="_" eval 'LABELS=${PHRASE[*]}'
    LABELS=$(echo "$LABELS" | tr , " ")
    INDEX=`termux-dialog radio -v "$(echo $LABELS | tr _ ,)" | jq -r .index`
    echo ${PHRASE[$INDEX]}
    termux-tts-speak -r 0.6 -p 0.7 ${PHRASE[$INDEX]}
    exit 0
fi

INDEX0=$(cat $STATUS)
INDEX=$INDEX0
while [ "$INDEX" = "$INDEX0" ]; do
      INDEX=$(expr $N \* $RANDOM / 32768)
done
echo $INDEX > "$STATUS"

# Random pitch between 0.1 and 1.7
PITCH=$(perl -e 'printf "%.1f", 0.1+1.6*rand()**2')

$HOME/.shortcuts/hulog -t "Teatime"

sleep 180 && termux-tts-speak -r 0.6 -p ${PITCH} ${PHRASE[$INDEX]} &
termux-toast "Starting tea-timer..."

